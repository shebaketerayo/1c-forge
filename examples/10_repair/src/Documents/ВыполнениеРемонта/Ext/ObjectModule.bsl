#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Движения по регистру Статусы устройств
	Движения.СтатусыУстройств.Записывать = Истина;
	Движение = Движения.СтатусыУстройств.Добавить();
	Движение.Период = Дата;
	Движение.Устройство = Устройство;
	Движение.Статус = Перечисления.СтатусыРемонта.Готов;

	// Движения по регистру Остатки запчастей
	Движения.ОстаткиЗапчастей.Записывать = Истина;
	Для Каждого СтрокаТЧ Из Запчасти Цикл
		Движение = Движения.ОстаткиЗапчастей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Запчасть = СтрокаТЧ.Запчасть;
		Движение.Количество = СтрокаТЧ.Количество;
	КонецЦикла;

	// Движения по регистру Выручка сервиса
	Движения.ВыручкаСервиса.Записывать = Истина;
	Для Каждого СтрокаТЧ Из Услуги Цикл
		Движение = Движения.ВыручкаСервиса.Добавить();
		Движение.Период = Дата;
		Движение.Мастер = Мастер;
		Движение.Услуга = СтрокаТЧ.Услуга;
		Движение.Сумма = СтрокаТЧ.Сумма;
	КонецЦикла;

	// Контроль остатков по регистру Остатки запчастей
	Движения.ОстаткиЗапчастей.БлокироватьДляИзменения = Истина;
	Движения.ОстаткиЗапчастей.Записать();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Запчасть КАК Запчасть,
	|	Остатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиЗапчастей.Остатки(
	|			,
	|			Запчасть В
	|				(ВЫБРАТЬ
	|					Т.Запчасть
	|				ИЗ
	|					РегистрНакопления.ОстаткиЗапчастей КАК Т
	|				ГДЕ
	|					Т.Регистратор = &Ссылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Недостаточно остатка (Остатки запчастей): " + Строка(Выборка.Запчасть) + ". Не хватает: " + Строка(-Выборка.КоличествоОстаток);
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого СтрокаТЧ Из Услуги Цикл
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
